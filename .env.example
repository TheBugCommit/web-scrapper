# ──────────────────────────────────────────────
# Web Scraper — Environment Configuration
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── SQL Server connection ──────────────────────
# Full SQLAlchemy connection string for SQL Server via pyodbc
# Example (SQL auth):
SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://username:password@server_host/database_name?driver=ODBC+Driver+17+for+SQL+Server
# Example (Windows auth / trusted connection):
# Note: Target table, schema, and upsert key are configured per-portal in portals.yml

# ── Concurrency ────────────────────────────────
# Maximum number of concurrent page-fetch workers
SCRAPER_MAX_CONCURRENT=5

# ── Debug / logging ────────────────────────────
# Set to "true" to enable debug crawler mode and verbose logging
SCRAPER_DEBUG=false
# Rotating file logs configuration (saved to SCRAPER_LOG_DIR/scraper.log & error.log)
SCRAPER_LOG_ENABLED=true
SCRAPER_LOG_DIR=./logs
SCRAPER_LOG_MAX_BYTES=10485760
SCRAPER_LOG_BACKUPS=5

# ── Rate limiting ──────────────────────────────
# Minimum seconds between requests to the same host
SCRAPER_RATE_LIMIT_DELAY=1.0

# ── Retry policy ──────────────────────────────
# Max number of retry attempts on transient failures
SCRAPER_MAX_RETRIES=3

# ── File downloads ────────────────────────────
# Directory where downloaded files will be saved
SCRAPER_DOWNLOAD_DIR=./downloads

# ── Playwright ────────────────────────────────
# Run browser in headless mode (true/false)
SCRAPER_HEADLESS=true
