# ─────────────────────────────────────────────────────────────
# Web Scraper — Portal & Infrastructure Environment Config
# Copy this file to 'portals/config/.env' and adjust the values.
# NOTE: Portal credentials (usernames/passwords) should go in
#       'portals_credentials.yml' instead of here.
# ─────────────────────────────────────────────────────────────

# ── SQL Server connection ────────────────────────────────────
# Full SQLAlchemy connection string for SQL Server via pyodbc
SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://username:password@server_host/database_name?driver=ODBC+Driver+17+for+SQL+Server

# ── Browser & Engine Execution Options ───────────────────────
SCRAPER_HEADLESS=true
SCRAPER_MAX_CONCURRENT=5
SCRAPER_RATE_LIMIT_DELAY=1.0
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=90000
SCRAPER_DEBUG=false
