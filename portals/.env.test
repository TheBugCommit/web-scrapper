# ══════════════════════════════════════════════════════════════════
#  TEST / DEVELOPMENT environment — portals/config/.env.test
#  Safe to commit — points to local/test infrastructure only.
#  To activate: copy-item .env.test .env   (PowerShell)
#               cp .env.test .env           (bash)
# ══════════════════════════════════════════════════════════════════

# ── SQL Server (local / test instance) ───────────────────────────
# Windows auth example (no user/password needed):
SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://localhost/ScraperDB_Test?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# ── Browser & Engine Execution Options ───────────────────────
SCRAPER_HEADLESS=false
SCRAPER_MAX_CONCURRENT=5
SCRAPER_RATE_LIMIT_DELAY=1.0
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=90000
SCRAPER_DEBUG=true
