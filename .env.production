# ══════════════════════════════════════════════════════════════════
#  PRODUCTION environment — .env.production
#  DO NOT commit real credentials. Use secrets management in CI/CD.
#  To activate: copy-item .env.production .env   (PowerShell)
#               cp .env.production .env           (bash)
# ══════════════════════════════════════════════════════════════════

# ── SQL Server ────────────────────────────────────────────────────
SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://prod_user:CHANGE_ME@prod-server.balfego.local/ScraperDB?driver=ODBC+Driver+17+for+SQL+Server
SCRAPER_DB_TABLE=scraped_data
SCRAPER_DB_UPSERT_KEY=
SCRAPER_DB_SCHEMA=dbo

# ── Concurrency ───────────────────────────────────────────────────
SCRAPER_MAX_CONCURRENT=10
SCRAPER_RATE_LIMIT_DELAY=1.0
SCRAPER_MAX_RETRIES=5

# ── Logging / debug ───────────────────────────────────────────────
SCRAPER_DEBUG=false

# ── File downloads ────────────────────────────────────────────────
SCRAPER_DOWNLOAD_DIR=./downloads

# ── Playwright ────────────────────────────────────────────────────
SCRAPER_HEADLESS=true

# ── Portal credentials (override per-portal) ──────────────────────
PORTAL_URL=https://portal.balfego.com
LOGIN_URL=https://portal.balfego.com/login
PORTAL_USERNAME=CHANGE_ME
PORTAL_PASSWORD=CHANGE_ME
