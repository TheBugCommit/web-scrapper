# ══════════════════════════════════════════════════════════════════
#  PRODUCTION environment — .env.production
#  DO NOT commit real credentials. Use secrets management in CI/CD.
#  To activate: copy-item .env.production .env   (PowerShell)
#               cp .env.production .env           (bash)
# ══════════════════════════════════════════════════════════════════

# ── SQL Server ────────────────────────────────────────────────────
SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://admin:CHANGE_ME@DATABALFEGO%5CDATAREPORTING/Reporting_Test?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# ── Concurrency ───────────────────────────────────────────────────
SCRAPER_MAX_CONCURRENT=10
SCRAPER_RATE_LIMIT_DELAY=1.0
SCRAPER_MAX_RETRIES=5

# ── Logging / debug ───────────────────────────────────────────────
SCRAPER_DEBUG=false
SCRAPER_LOG_ENABLED=true
SCRAPER_LOG_DIR=./logs
SCRAPER_LOG_MAX_BYTES=10485760
SCRAPER_LOG_BACKUPS=10

# ── File downloads ────────────────────────────────────────────────
SCRAPER_DOWNLOAD_DIR=./downloads
