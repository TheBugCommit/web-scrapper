# ══════════════════════════════════════════════════════════════════
#  TEST / DEVELOPMENT environment — .env.test
#  Safe to commit — points to local/test infrastructure only.
#  To activate: copy-item .env.test .env   (PowerShell)
#               cp .env.test .env           (bash)
# ══════════════════════════════════════════════════════════════════

# ── SQL Server (local / test instance) ───────────────────────────
# Windows auth example (no user/password needed):
SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://localhost/ScraperDB_Test?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# SQL auth example (uncomment and adjust):
# SCRAPER_DB_CONNECTION_STRING=mssql+pyodbc://sa:TestPass123@localhost/ScraperDB_Test?driver=ODBC+Driver+17+for+SQL+Server
SCRAPER_DB_TABLE=scraped_data_test
SCRAPER_DB_UPSERT_KEY=
SCRAPER_DB_SCHEMA=dbo

# ── Concurrency (lower for local testing) ─────────────────────────
SCRAPER_MAX_CONCURRENT=2
SCRAPER_RATE_LIMIT_DELAY=0.5
SCRAPER_MAX_RETRIES=2

# ── Logging / debug ───────────────────────────────────────────────
SCRAPER_DEBUG=true

# ── File downloads ────────────────────────────────────────────────
SCRAPER_DOWNLOAD_DIR=./downloads/test

# ── Playwright (visible browser for debugging) ────────────────────
SCRAPER_HEADLESS=false

# ── Portal credentials (test / sandbox portal) ────────────────────
PORTAL_URL=https://sandbox.portal.balfego.com
LOGIN_URL=https://sandbox.portal.balfego.com/login
PORTAL_USERNAME=test_user
PORTAL_PASSWORD=test_password
